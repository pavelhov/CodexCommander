---
// Landing page. Liquid Editorial composition: type-led centered hero, provider
// pill chips as content, product-as-stage media band, quickstart terminal,
// bento feature slab, docs link row.
// Styling lives in src/styles/custom.css under the `.lp` namespace.
import { Image } from 'astro:assets';
import {
	siAnthropic,
	siDeepseek,
	siGoogle,
	siMoonshotai,
	siOllama,
	siOpenrouter,
} from 'simple-icons';
import picker from '../assets/codex-app-picker.png';
import heroFieldLight from '../assets/hero-route-light.png';
import heroFieldDark from '../assets/hero-route-dark.png';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const prefix = base;

const icons: Record<string, string> = {
	// Lucide outline paths (24x24, stroke)
	plug: 'M12 22v-5M9 8V2M15 8V2M6 8h12l-1 6a5 5 0 0 1-10 0Z',
	key: 'M21 2l-2 2m-7.61 7.61a5.5 5.5 0 1 1-7.778 7.778 5.5 5.5 0 0 1 7.777-7.777Zm0 0L15.5 7.5m0 0 3 3L22 7l-3-3m-3.5 3.5L19 4',
	users: 'M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8Zm13 10v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75',
	picker: 'M3 5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2Zm6-2v18M3 9h6',
	bot: 'M12 8V4H8m8 0h-4M4 12a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2Zm11 3h.01M9 15h.01M2 14h2m16 0h2',
	search: 'M11 19a8 8 0 1 0 0-16 8 8 0 0 0 0 16Zm10 2-4.35-4.35',
	rocket: 'M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09ZM12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2Zm-3-3H4s.55-3.03 2-4c1.62-1.08 5 0 5 0m0 9v5s3.03-.55 4-2c1.08-1.62 0-5 0-5',
	book: 'M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20',
	code: 'M16 18l6-6-6-6M8 6l-6 6 6 6',
	terminal: 'M4 17l6-6-6-6M12 19h8',
	folder: 'M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z',
};

// Official monochrome marks from simple-icons where the brand exists in the
// library; brands missing from it stay text-only (no generic substitutes).
const providers: { label: string; path?: string }[] = [
	{ label: 'Anthropic', path: siAnthropic.path },
	{ label: 'Google', path: siGoogle.path },
	{ label: 'xAI' },
	{ label: 'Kimi', path: siMoonshotai.path },
	{ label: 'Ollama Cloud', path: siOllama.path },
	{ label: 'Groq' },
	{ label: 'OpenRouter', path: siOpenrouter.path },
	{ label: 'Azure' },
	{ label: 'DeepSeek', path: siDeepseek.path },
	{ label: 'GLM' },
];

const quickstartMini = [
	{ cmd: 'bun install && bun run build:gui', note: 'Prepare this checkout' },
	{ cmd: 'bun run src/cli/index.ts init', note: 'Initialize CodexCommander' },
	{ cmd: 'bun run src/cli/index.ts start', note: 'Start the proxy' },
];

const quickstart = [
	{ cmd: 'bun install && bun run build:gui', note: 'Prepare this checkout' },
	{ cmd: 'bun run src/cli/index.ts init', note: 'Inject a provider into Codex' },
	{ cmd: 'bun run src/cli/index.ts start', note: 'Start the proxy' },
	{ cmd: 'codex "Write a hello world in Rust"', note: 'Codex now routes through ccx' },
];

// full docs map for the closing sitemap band (also the mobile path to every section)
const docsMap = [
	{
		label: 'Getting Started',
		icon: 'rocket',
		links: [
			{ label: 'Installation', href: `${prefix}getting-started/installation/` },
			{ label: 'Quickstart', href: `${prefix}getting-started/quickstart/` },
			{ label: 'How It Works', href: `${prefix}getting-started/how-it-works/` },
			{ label: 'Agent Quickstart', href: `${prefix}getting-started/for-agents/` },
		],
	},
	{
		label: 'Guides',
		icon: 'book',
		links: [
			{ label: 'Providers', href: `${prefix}guides/providers/` },
			{ label: 'Model Routing', href: `${prefix}guides/model-routing/` },
			{ label: 'Combos', href: `${prefix}guides/combos/` },
			{ label: 'Codex Integration', href: `${prefix}guides/codex-integration/` },
			{ label: 'Codex App Model Picker', href: `${prefix}guides/codex-app-models/` },
			{ label: 'Claude Code', href: `${prefix}guides/claude-code/` },
			{ label: 'Sidecars: Search & Vision', href: `${prefix}guides/sidecars/` },
			{ label: 'Web Dashboard', href: `${prefix}guides/web-dashboard/` },
			{ label: 'Sub-agent Surface', href: `${prefix}guides/sub-agent-surface/` },
		],
	},
	{
		label: 'Reference',
		icon: 'code',
		links: [
			{ label: 'CLI', href: `${prefix}reference/cli/` },
			{ label: 'Configuration', href: `${prefix}reference/configuration/` },
			{ label: 'Adapters', href: `${prefix}reference/adapters/` },
			{ label: 'Architecture', href: `${prefix}reference/architecture/` },
			{ label: 'Proxy API Formats', href: `${prefix}reference/proxy-formats/` },
			{ label: 'Management API', href: `${prefix}reference/management-api/` },
		],
	},
	{
		label: 'Project',
		icon: 'folder',
		links: [
			{ label: 'Contributing', href: `${prefix}contributing/` },
			{ label: 'GitHub', href: 'https://github.com/pavelhov/CodexCommander' },
		],
	},
];
---

<div class="lp not-content">
	<!-- scene stack: hero -> quickstart -> horizontal rail. Each wrapper owns a
	     named view-timeline; its sticky inner stage pins under the pill header
	     while the next scene rides over it (motion.md sticky stacking +
	     scale-depth morph). -->
	<div class="lp-scenes">
	<section class="lp-scene lp-scene-hero">
	<div class="lp-scene-inner lp-hero-field">
		<div class="lp-field-bg" aria-hidden="true">
			<Image src={heroFieldLight} alt="" class="lp-field-light" loading="eager" widths={[1024, 2048]} sizes="100vw" />
			<Image src={heroFieldDark} alt="" class="lp-field-dark" loading="lazy" widths={[1024, 2048]} sizes="100vw" />
		</div>
		<div class="lp-hero-copy">
			{/* Product-word drum: the H1 performs the claim — the proxy serves both
			    Codex and Claude Code. 4-face rotateX cylinder, fixed slot width via
			    inline-grid stacking; reduced-motion collapses to a static pairing. */}
			<h1 id="_top">
				{'Run '}<span class="lp-drum" aria-label="Codex and Claude">
					<span class="lp-drum-spin" aria-hidden="true">
						<span class="lp-drum-face lp-drum-codex">Codex</span>
						<span class="lp-drum-face lp-drum-claude">Claude</span>
						<span class="lp-drum-face lp-drum-codex">Codex</span>
						<span class="lp-drum-face lp-drum-claude">Claude</span>
					</span>
					<span class="lp-drum-static" aria-hidden="true">Codex<span class="lp-drum-dot"> · </span>Claude</span>
				</span>{' on any LLM.'}
			</h1>
			<p class="lp-sub">
				{'CodexCommander is a local proxy that serves Codex and Claude Code from one port — translating each wire format to any provider, with streaming, tool calls, reasoning, and images in both directions. Zero client patches.'}
			</p>
			<div class="lp-cta">
				<a class="lp-btn-primary" href={`${prefix}getting-started/installation/`}>
					{'Get Started'}
					<svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
				</a>
				<a class="lp-btn-ghost" href="https://github.com/pavelhov/CodexCommander">GitHub</a>
			</div>
		<ul class="lp-chips" aria-label={'Supported providers'}>
				{providers.map((p) => (
					<li>
						{p.path && (
							<svg class="lp-chip-mark" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
								<path d={p.path} />
							</svg>
						)}
						{p.label}
					</li>
				))}
				<li class="lp-chip-more"><a href={`${prefix}guides/providers/`}>{'40+ providers'}</a></li>
			</ul>
		</div>
		<div class="lp-stage-in">
			<img src={`${base}og.png`} alt={'CodexCommander — universal provider proxy for OpenAI Codex and Claude Code'} loading="eager" width="1200" height="630" />
		</div>
	</div>
	</section>

	<!-- quickstart sheet scene -->
	<section class="lp-scene lp-scene-quick">
	<div class="lp-scene-inner lp-quick">
		<div class="lp-kinetic" aria-label={'Install. Start. Codex, rerouted.'}>
			<p class="lp-kline">{'Install.'}</p>
			<p class="lp-kline">{'Start.'}</p>
			<p class="lp-kline lp-kline-accent">{'Codex, rerouted.'}</p>
		</div>
		<div class="lp-quick-side">
			<div class="lp-terminal">
				<div class="lp-terminal-bar"><span>zsh</span></div>
				<pre>{quickstartMini.map((line) => (<code><span class="lp-prompt">$ </span>{line.cmd}<span class="lp-note">  # {line.note}</span>{'\n'}</code>))}</pre>
			</div>
			<a class="lp-inline-link" href={`${prefix}getting-started/quickstart/`}>{'Full quickstart'} →</a>
		</div>
	</div>
	</section>

	</div>
	<!-- feature bento: dominant cell + content-weighted spans -->
	<section class="lp-bento">
		<h2 class="lp-bento-title">{'One proxy, the whole surface.'}</h2>
		<div class="lp-grid">
			<article class="lp-cell lp-cell-providers">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.plug} /></svg>{'Any provider'}</h3>
				<p>
					{'Five adapters cover Anthropic Messages, Google Gemini, Azure, the OpenAI Responses passthrough, and every OpenAI-compatible Chat Completions endpoint — 40+ built-in providers.'}
				</p>
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.key} /></svg>{'OAuth or API key'}</h3>
				<p>{'Log in with your xAI, Anthropic, or Kimi account — auto-refreshed — forward your ChatGPT login, or paste a key.'}</p>
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.users} /></svg>{'ChatGPT account pool'}</h3>
				<p>{'Existing threads keep their account; new sessions auto-route to the lowest-usage healthy one after quota refresh.'}</p>
			</article>
			<article class="lp-cell lp-cell-picker">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.picker} /></svg>{'Native in the model picker'}</h3>
				<p>{'Routed models show up in Codex App with reasoning effort levels, next to the native ones.'}</p>
				<Image src={picker} alt={'Codex App model picker with reasoning effort levels'} loading="lazy" />
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.bot} /></svg>{'Sub-agents'}</h3>
				<p>{'Pin up to five featured spawn_agent suggestions, and switch the V1 / base / V2 surface globally.'}</p>
			</article>
			<article class="lp-cell lp-cell-claude">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.terminal} /></svg>Claude Code</h3>
				<p>{'ccx claude launches Claude Code against the same port — every routed model in the /model picker, auto-context up to 1M, roster sub-agents, and your claude.ai login stays active.'}</p>
			</article>
			<article class="lp-cell">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.search} /></svg>{'Search & vision sidecars'}</h3>
				<p>{'Give non-OpenAI models real web search and image understanding through a gpt-5.4-mini sidecar.'}</p>
			</article>
			<article class="lp-cell lp-cell-terminal">
				<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons.code} /></svg>{'Quickstart'}</h3>
				<p>{'ccx init writes a provider into your Codex config and shares one model catalog with Codex CLI, TUI, App, and SDK. ccx stop restores native Codex cleanly.'}</p>
				<div class="lp-terminal">
					<div class="lp-terminal-bar"><span>zsh</span></div>
					<pre>{quickstart.map((line) => (<code><span class="lp-prompt">$ </span>{line.cmd}<span class="lp-note">  # {line.note}</span>{'\n'}</code>))}</pre>
				</div>
			</article>
		</div>
	</section>

	<!-- full docs sitemap band: every section reachable from the landing -->
	<section class="lp-next" aria-label={'Documentation map'}>
		<h2>{'Explore the docs'}</h2>
		<div class="lp-next-grid">
			{docsMap.map((group) => (
				<div class="lp-next-col">
					<h3><svg class="lp-ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[group.icon]} /></svg>{group.label}</h3>
					<ul>
						{group.links.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</div>
			))}
		</div>
	</section>

	<p class="lp-disclaimer">
		{'CodexCommander is an independent community project, not affiliated with or endorsed by OpenAI, Anthropic, or any other provider. Some providers may restrict accounts that route traffic through third-party proxies — review each provider\u2019s Terms of Service before connecting.'}
	</p>
</div>
